#Requires -Version 5
# ==============================================================================
# vuln_privesc — group-membership PE surfaces (BATCHED, coruscant only).
# PE-005/006/059 svc_darryl in Warehouse (SeBackup/SeRestore -> NTDS.dit),
# PE-057 developer1 in Server Operators, PE-018 SYSVOL Scripts DACL loosen,
# PE-019 SYSTEM-only flag (SeBackup read path). Replaces ~8 round-trips with 1.
# ==============================================================================
$ErrorActionPreference = 'Continue'
$log = 'C:\DunderLab\vuln_pe_groups.log'
New-Item -ItemType Directory -Force -Path (Split-Path $log) | Out-Null
function Log($m) { Add-Content -Path $log -Value "$(Get-Date -Format o) $m"; Write-Output $m }
Import-Module ActiveDirectory -ErrorAction SilentlyContinue

# ── PE-005/059: svc_darryl in Warehouse ──────────────────────────────────────
try {
  $m = Get-ADGroupMember -Identity "Warehouse" -ErrorAction Stop | Select-Object -ExpandProperty SamAccountName
  if ($m -contains "svc_darryl") { Log "OK: PE-005 svc_darryl already in Warehouse" }
  else { Add-ADGroupMember -Identity "Warehouse" -Members "svc_darryl" -ErrorAction Stop; Log "CHANGED: PE-005 svc_darryl added to Warehouse" }
} catch { Log "ERROR: PE-005 $($_.Exception.Message)" }

# ── PE-057: developer1 in Server Operators ───────────────────────────────────
try {
  $m = Get-ADGroupMember -Identity "Server Operators" -ErrorAction Stop | Select-Object -ExpandProperty SamAccountName
  if ($m -contains "developer1") { Log "OK: PE-057 developer1 already in Server Operators" }
  else { Add-ADGroupMember -Identity "Server Operators" -Members "developer1" -ErrorAction Stop; Log "CHANGED: PE-057 developer1 added to Server Operators" }
} catch { Log "ERROR: PE-057 $($_.Exception.Message)" }

# ── PE-018: SYSVOL Machine\Scripts DACL writable by Authenticated Users ──────
try {
  $domain  = (Get-ADDomain -Server localhost).DNSRoot
  $gpoRoot = "C:\Windows\SYSVOL\sysvol\$domain\Policies"
  if (Test-Path $gpoRoot) {
    Get-ChildItem $gpoRoot -Directory | ForEach-Object {
      $scripts = Join-Path $_.FullName "Machine\Scripts\Startup"
      if (-not (Test-Path $scripts)) { New-Item -ItemType Directory -Path $scripts -Force | Out-Null }
      icacls $scripts /grant "EMPIRE\Authenticated Users:(OI)(CI)M" 2>$null | Out-Null
    }
    Log "CHANGED: PE-018 SYSVOL Scripts DACL loosened"
  } else { Log "OK: PE-018 SYSVOL Policies path not found (skipped)" }
} catch { Log "ERROR: PE-018 $($_.Exception.Message)" }

# ── PE-019: SYSTEM-only flag (readable via SeBackupPrivilege) ─────────────────
try {
  New-Item -ItemType Directory -Force -Path 'C:\Flags' | Out-Null
  $flag = @'
DUNDER{PE-019_BACKUP_OPERATORS_READ_PATH}
Nothing stresses me out. Except having to seek the approval of my inferiors. — Dwight Schrute
'@
  Set-Content -Path 'C:\Flags\dc-system-only.txt' -Value $flag -Encoding UTF8
  icacls "C:\Flags\dc-system-only.txt" /inheritance:r 2>$null | Out-Null
  icacls "C:\Flags\dc-system-only.txt" /grant "NT AUTHORITY\SYSTEM:F" 2>$null | Out-Null
  icacls "C:\Flags\dc-system-only.txt" /grant "BUILTIN\Administrators:F" 2>$null | Out-Null
  Log "CHANGED: PE-019 SYSTEM-only flag dropped + locked"
} catch { Log "ERROR: PE-019 $($_.Exception.Message)" }

Write-Output "DONE"
