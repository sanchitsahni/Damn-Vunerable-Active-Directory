# Copy to .env and fill in. .env is gitignored (contains the admin hash).
# ------------------------------------------------------------------------------

# Public IP (or DNS name) of the VPS — what players' clients dial.
WG_HOST=YOUR.VPS.PUBLIC.IP

# Admin UI (http://<VPS_IP>:51821) password hash.
# Generate:  docker run --rm ghcr.io/wg-easy/wg-easy wgpw 'YOURPASS'
# Paste the value it prints (the $2a$... bcrypt string). In a .env file a single
# $ is literal — do NOT double it here (doubling is only for inline compose).
PASSWORD_HASH=$2a$12$REPLACE_WITH_GENERATED_HASH
